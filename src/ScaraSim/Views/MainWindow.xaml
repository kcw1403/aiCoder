<Window x:Class="ScaraSim.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:ScaraSim.ViewModels"
        Title="SCARA 3D Robot Simulator"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1E23"
        TextElement.Foreground="#FFE6E8EB"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF8B93A0" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="JointLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFC7CCD3" />
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Background" Value="#FF272B32" />
            <Setter Property="Foreground" Value="#FFE6E8EB" />
            <Setter Property="BorderBrush" Value="#FF3A3F47" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E7DD1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12" CornerRadius="8" ClipToBounds="True"
                Background="#FF15181C">
            <h:HelixViewport3D x:Name="Viewport"
                               Background="#FF15181C"
                               ShowCoordinateSystem="True"
                               ShowViewCube="True"
                               ZoomExtentsWhenLoaded="True"
                               IsHeadLightEnabled="False">
                <h:GridLinesVisual3D Width="2000" Length="2000"
                                     MinorDistance="100" MajorDistance="500"
                                     Thickness="1.2"
                                     Fill="#FF2A2F36" />
                <ModelVisual3D Content="{Binding SceneModels}" />
            </h:HelixViewport3D>
        </Border>

        <Border Grid.Column="1" Margin="0,12,12,12" Padding="16"
                CornerRadius="8" Background="#FF22262C">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SCARA Simulator"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#FFFFFFFF" />
                    <TextBlock Text="5-Axis RPRR Dual-Yaw"
                               Foreground="#FF8B93A0" Margin="0,2,0,0" />

                    <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                            Background="{Binding IsColliding, Converter={x:Static vm:CollisionBrushConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="Interference (AABB)"
                                       FontSize="11" Foreground="#FFEDEFF2" Opacity="0.85" />
                            <TextBlock Text="{Binding CollisionStatus}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="White" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="JOINT AXES" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="q1" Style="{StaticResource JointLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="-180" Maximum="180"
                                Value="{Binding Q1}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueBox}"
                                 Text="{Binding Q1, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S2" Style="{StaticResource JointLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding S2Max}"
                                Value="{Binding S2}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueBox}"
                                 Text="{Binding S2, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="q3" Style="{StaticResource JointLabel}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="-180" Maximum="180"
                                Value="{Binding Q3}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueBox}"
                                 Text="{Binding Q3, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="q4" Style="{StaticResource JointLabel}" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180"
                                Value="{Binding Q4}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueBox}"
                                 Text="{Binding Q4, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="q5" Style="{StaticResource JointLabel}" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180"
                                Value="{Binding Q5}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueBox}"
                                 Text="{Binding Q5, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Button Content="Reset Pose" Command="{Binding ResetPoseCommand}"
                            Background="#FF3A3F47" Margin="0,8,0,0" />

                    <TextBlock Text="LINK DIMENSIONS (mm)" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Link 1"
                                   VerticalAlignment="Center" Foreground="#FFC7CCD3" Margin="0,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueBox}"
                                 Text="{Binding Link1Length, StringFormat=F0, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Link 2"
                                   VerticalAlignment="Center" Foreground="#FFC7CCD3" Margin="0,4" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueBox}"
                                 Text="{Binding Link2Length, StringFormat=F0, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tool"
                                   VerticalAlignment="Center" Foreground="#FFC7CCD3" Margin="0,4" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueBox}"
                                 Text="{Binding ToolLength, StringFormat=F0, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <TextBlock Text="MESH IMPORT" Style="{StaticResource SectionHeader}" />
                    <Button Content="Load Environment Mesh (STL/OBJ)…"
                            Command="{Binding LoadEnvironmentMeshCommand}" />
                    <Button Content="Load Robot Part Mesh…"
                            Command="{Binding LoadRobotPartMeshCommand}"
                            Background="#FF3A3F47" />
                    <Button Content="Clear Imported Meshes"
                            Command="{Binding ClearEnvironmentCommand}"
                            Background="#FF3A3F47" />

                    <Border Margin="0,16,0,0" Padding="10" CornerRadius="6"
                            Background="#FF191C21">
                        <StackPanel>
                            <TextBlock Text="{Binding JointSummary}"
                                       Foreground="#FF9BA3AF" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#FF6B7280" Margin="0,6,0,0"
                                       TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
